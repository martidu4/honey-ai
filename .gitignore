# OpenClaw HoneyAI — .gitignore
# ─────────────────────────────────────────────────
# NEVER commit secrets or generated configs

# 🔐 Private — API keys, personal config
/.env
.env.*
config.yaml
# deployment-specific configs (config.pi5.yaml, etc.)
config.*.yaml
# persistent SSH host key
.host_key

# 📁 Runtime data
logs/
logs-demo/
*.log

# 🧪 Scratch / debug scripts
scratch/
*.bak
*.orig
*.rej
# el bueno es ai/engine.js; una copia en la raiz es basura
/engine.js

# 🟦 Node
node_modules/
npm-debug.log*
package-lock.json

# 🍎 macOS
.DS_Store
._.DS_Store

# 💻 IDE
.vscode/
.idea/
*.swp

# 📊 Blog (Astro) — build artifacts
blog/dist/
blog/.astro/
blog/.vercel/
blog/.env.local
blog/.env.production.local
blog/node_modules/
.opsec-terms
